{
  "protocol": "Ethernet",
  "preconditions": [
    "current_dut_identity",
    "current_spec_revision",
    "current_vip_or_native_uvc_identity",
    "toolchain_identity"
  ],
  "gates": [
    {
      "name": "EVIDENCE_READY",
      "requires": [
        "MII_GMII_XGMII_USXGMII_or_other",
        "speed_modes",
        "MAC_addressing",
        "PCS_PMA_boundary"
      ]
    },
    {
      "name": "ENV_GENERATED",
      "requires": [
        "generated_sources",
        "manifest",
        "filelist"
      ]
    },
    {
      "name": "COMPILE_QUALIFIED",
      "requires": [
        "compile_exit_zero",
        "no_unwaived_compile_error"
      ]
    },
    {
      "name": "SMOKE_QUALIFIED",
      "requires": [
        "reset",
        "link_bringup",
        "tx_frame",
        "rx_frame",
        "CRC_check",
        "speed_mode_smoke"
      ]
    },
    {
      "name": "PROTOCOL_QUALIFIED",
      "requires": [
        "checker_or_scoreboard_pass",
        "protocol_coverage_evidence"
      ]
    },
    {
      "name": "REGRESSION_QUALIFIED",
      "requires": [
        "qualification_regression_pass"
      ]
    },
    {
      "name": "PRODUCTION_QUALIFIED",
      "requires": [
        "traceable_release",
        "all_previous_gates",
        "no_unresolved_blocker"
      ]
    }
  ]
}