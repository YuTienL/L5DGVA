      "system virtual sequencer",
      "cross-subsystem scenario manager",
      "cross-subsystem scoreboard",
      "SoC coverage",
      "system regression plan"
    ]
  },
  "validator": "tools/real_env/system_level_validator.py",
  "hard_gate": true
}