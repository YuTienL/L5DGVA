     force master_bind_if.armmusid   = master_if.armmusid;
     force master_bind_if.armmussidv   = master_if.armmussidv;
     force master_bind_if.armmussid   = master_if.armmussid;
     force master_bind_if.armmuatst   = master_if.armmuatst;
     force master_bind_if.wdatachk   = master_if.wdatachk;
     force master_bind_if.wtrace   = master_if.wtrace;
     force master_bind_if.wpoison   = master_if.wpoison;
     force master_bind_if.cddatachk   = master_if.cddatachk;
     force master_bind_if.cdpoison   = master_if.cdpoison;
     force master_bind_if.cdtrace   = master_if.cdtrace;
     force master_bind_if.awakeup   = master_if.awakeup;
     force master_bind_if.crtrace   = master_if.crtrace;
   end 
 end

