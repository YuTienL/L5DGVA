    slave_if.arvalid  =  slave_bind_if.arvalid;
    slave_if.araddr   =  slave_bind_if.araddr;
    slave_if.arlen    =  slave_bind_if.arlen;
    slave_if.arsize   =  slave_bind_if.arsize;
